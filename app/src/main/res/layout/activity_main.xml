<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_default_background">

    <TextView
        android:id="@+id/textMainTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_title"
        android:textSize="30sp"
        android:textColor="@color/color_text_light"
        android:background="@color/title_background"
        android:gravity="center"
        android:padding="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imageMain"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:src="@drawable/chinese_municipalities"
            android:scaleType="fitCenter"
            android:contentDescription="@string/main_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prompt_municipality"
            android:textColor="@color/color_text_dark"
            android:textSize="16sp"

            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/editMunicipality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_municipality"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:textColor="@color/color_text_dark"
            android:textColorHint="#888888" />

    </LinearLayout>
</LinearLayout>