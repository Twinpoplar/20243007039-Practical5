<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/color_default_background">

    <!-- Display the selected municipality name. Background and text color are set dynamically in Java -->
    <TextView
        android:id="@+id/textMunicipalityName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_light" />

    <!-- Display the corresponding image for the municipality -->
    <ImageView
        android:id="@+id/imageMunicipality"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/main_title" />

    <!-- Scrollable area for the information text. Weight=1 ensures the button stays at the bottom -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:fillViewport="true">

        <!-- Display the factual summary from the string array -->
        <TextView
            android:id="@+id/textMunicipalityInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/color_text_dark" />
    </ScrollView>

    <!-- Button to open the official website using an implicit intent -->
    <Button
        android:id="@+id/buttonVisitSite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/visit_site"
        android:textColor="@color/color_text_light"
        android:textAllCaps="false" />

</LinearLayout>